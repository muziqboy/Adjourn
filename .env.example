# Copy to .env. With everything on mock, Adjourn runs with no keys and no network.

# Which agents the meeting agent may create tasks for (backend/app/agents/)
AGENTS=answer,issue,schedule

# --- model: mock | gemini ---
LLM_MODE=mock
GEMINI_API_KEY=
MODEL_FAST=gemini-3.8-flash
MODEL_LIVE=gemini-3.8-live
# Roles routed through Condense, e.g. "intent". Empty = off. (Not implemented yet: docs/SCOPE.md)
CONDENSE_ROLES=
CONDENSE_BASE_URL=
CONDENSE_API_KEY=

# --- integrations: mock (no network) | links (prefilled pages, no sign-in) | live ---
GOOGLE_MODE=mock
GITHUB_MODE=mock
# owner/name, and a fine-grained token with "Issues: read and write" on that repo
GITHUB_REPO=
GITHUB_TOKEN=

# --- meeting bot (Recall.ai): joins the Meet as "Adjourn", hears with names, speaks ---
# API key from https://<region>.recall.ai/dashboard/developers/api-keys (keys are region-bound)
RECALL_API_KEY=
RECALL_REGION=us-west-2
# Public URL of this backend, for Recall's transcript webhooks:
#   cloudflared tunnel --url http://localhost:8010   -> paste the https://….trycloudflare.com URL
PUBLIC_URL=
BOT_NAME=Adjourn

# --- meeting defaults: prefill the setup screen; used by replays ---
TIMEZONE=Europe/Stockholm
ME_NAME=Alex
ME_EMAIL=demo-a@gmail.com
GUEST_NAME=Bea
GUEST_EMAIL=demo-b@gmail.com

# Mock mode only: multiplier for the fake model delays (tests use 0.02)
MOCK_DELAY=1.0
