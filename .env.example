# Copy to .env. With everything on mock, Adjourn runs with no keys and no network.

# Which agents the meeting agent may create tasks for (backend/app/agents/)
AGENTS=answer,issue,schedule

# --- model: mock | gemini ---
LLM_MODE=mock
GEMINI_API_KEY=
MODEL_FAST=gemini-3.8-flash
MODEL_LIVE=gemini-3.8-live
# Roles routed through Condense, e.g. "intent". Empty = off.
CONDENSE_ROLES=
# The live-voice turn-taking mind: small and fast (scripts/eval_floor.py)
FLOOR_MODEL=gemini-3.5-flash-lite
FLOOR_THINKING=minimal
# Task types people in the call may approve by voice (others need the panel click)
VOICE_APPROVAL=linear,schedule
CONDENSE_BASE_URL=
CONDENSE_API_KEY=

# --- integrations: mock (no network) | links (prefilled pages, no sign-in) | live ---
GOOGLE_MODE=mock
GITHUB_MODE=mock
# owner/name, and a fine-grained token with "Issues: read and write" on that repo
GITHUB_REPO=
GITHUB_TOKEN=

# --- Linear (agents/linear.py): a Gemini agent works in Linear through Linear's MCP server ---
# The key is the switch: set it and the Linear agent is on and live; leave it empty and it is off.
# Use a personal API key from a TEST Linear workspace: the agent acts as that key's owner.
LINEAR_API_KEY=
# Optional: the team's ticket prefix (e.g. ADJ); empty = the agent finds the team itself
LINEAR_TEAM=
# Optional: LINEAR_MODE=mock forces the fake Linear even with a key
# LINEAR_MODE=mock

# --- meeting bot (Recall.ai): joins the Meet as "Adjourn", hears with names, speaks ---
# API key from https://<region>.recall.ai/dashboard/developers/api-keys (keys are region-bound)
RECALL_API_KEY=
RECALL_REGION=us-west-2
# Public URL of this backend, for Recall's transcript webhooks:
#   cloudflared tunnel --url http://localhost:8010   -> paste the https://….trycloudflare.com URL
PUBLIC_URL=
BOT_NAME=Adjourn
# The bot's voice: Gemini speech model + voice (Kore, Puck, Charon, ...); macOS voice as fallback
TTS_MODEL=gemini-3.8-flash-tts
TTS_VOICE=Kore
MAC_VOICE=Daniel
# Any random string; keep it fixed so a bot in a call keeps working across backend restarts
RECALL_WEBHOOK_TOKEN=
# Calendar auto-join: true = on start, connect the demo account's Google Calendar (token.json)
# to Recall and send the bot to every Google Meet on it at start time. The panel's
# "Connect calendar" does the same without a restart. Needs PUBLIC_URL and a fixed token above.
AUTO_JOIN=false

# --- meeting defaults: prefill the setup screen; used by replays ---
TIMEZONE=Europe/Stockholm
ME_NAME=Alex
ME_EMAIL=demo-a@gmail.com
GUEST_NAME=Bea
GUEST_EMAIL=demo-b@gmail.com

# Mock mode only: multiplier for the fake model delays (tests use 0.02)
MOCK_DELAY=1.0
